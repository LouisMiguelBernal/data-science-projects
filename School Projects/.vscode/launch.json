{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch",                    // Unique name for the configuration
            "type": "cppdbg",                        // Specifies the C++ debugger
            "request": "launch",                      // Request to launch the program
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe", // Path to the executable
            "args": [],                               // Command line arguments
            "stopAtEntry": false,                     // Set to true to stop at the main function
            "cwd": "${workspaceFolder}",              // Current working directory
            "environment": [],                         // Environment variables (if any)
            "externalConsole": false,                  // Use integrated console or external
            "MIMode": "gdb",                          // GDB mode for debugging
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe", // Path to gdb
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"                 // Task to run before launching
        }
    ]
}
